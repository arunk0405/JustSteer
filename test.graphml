<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d2" for="edge" attr.name="length" attr.type="string" />
  <key id="d1" for="node" attr.name="x" attr.type="string" />
  <key id="d0" for="node" attr.name="y" attr.type="string" />
  <graph edgedefault="directed">
    <node id="1">
      <data key="d0">10.0</data>
      <data key="d1">10.0</data>
    </node>
    <node id="2">
      <data key="d0">20.0</data>
      <data key="d1">20.0</data>
    </node>
    <edge source="1" target="2" id="0">
      <data key="d2">10</data>
    </edge>
  </graph>
</graphml>
