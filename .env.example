# .env.example
# Copy this to .env and fill in your values for local development.
# .env is gitignored — never commit real secrets.
#
# Load automatically if you add: from dotenv import load_dotenv; load_dotenv()
# at the top of each script, OR run: export $(cat .env | xargs)

# ── TomTom API (free tier: 2,500 requests/day) ────────────────────────────────
# Sign up at: https://developer.tomtom.com/
TOMTOM_API_KEY=your_tomtom_api_key_here

# ── GitHub (for drift_monitor.py to trigger the retraining workflow) ──────────
# Create a Fine-grained PAT at: https://github.com/settings/tokens
# Required permissions: Contents (read+write), Actions (write)
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=JustSteer

# ── MLflow (optional — defaults to local ./mlruns directory) ──────────────────
# Uncomment and set to use a remote MLflow tracking server:
# MLFLOW_TRACKING_URI=http://localhost:5000
